# .env.production.example
# =============================================
# Variables de entorno para PRODUCCIÓN
# Copia los valores reales desde:
#   - JWT_SECRET: inéntalo tú mismo (texto largo)
#   - DB_*: los consigues en Supabase → Settings → Database
#   - VITE_API_URL: la URL que te da Render al desplegar
# =============================================

# ── BACKEND (Render) ──────────────────────────
PORT=3001
JWT_SECRET=pon_aqui_una_clave_muy_larga_y_segura_123456

# Datos de conexión a Supabase (PostgreSQL)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password_de_supabase

# ── FRONTEND (Vercel) ─────────────────────────
# Esta variable le dice a React dónde está el backend
# Reemplaza con la URL real que te da Render
VITE_API_URL=https://sabanamarket-api.onrender.com/api
